ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Optional live OPRA source; Alpaca still owns positions and submits orders.
OPTION_DATA_PROVIDER=alpaca
TRADIER_API_KEY=

GROQ_API_KEY=

GROQ_MODEL_FAST=qwen/qwen3.8-27b
GROQ_MODEL_SMART=openai/gpt-oss-120b
GPT_OSS_MAX_TOKENS=512

ORDER_TYPE=limit
LIMIT_SLIPPAGE_PCT=0.05
QUOTE_FALLBACK_MARKET=true

LLM_REVIEW_FALLBACK_APPROVE=true

REGIME_GATE_ENABLED=true
REGIME_MIN_CONFIDENCE=0.5
MAX_CONTRACTS_PER_TRADE=10

MAX_RISK_PER_TRADE=0.02
MAX_PORTFOLIO_DELTA=0.3
MAX_DAILY_LOSS=0.03
MAX_POSITIONS=5
MIN_OPEN_INTEREST=100
MAX_BID_ASK_SPREAD_PCT=0.10
MIN_DTE=7

# Opt-in strategy documented in soxl_strategy/soxl.md
SOXL_STRATEGY_ENABLED=false
SOXL_UNDERLYING_REBALANCE_ENABLED=false

EXIT_ENABLED=true
EXIT_FORCE_DTE=7
EXIT_DTE_SCALE_MAX=35
EXIT_TP_MIN=0.15
EXIT_TP_MAX=0.40
EXIT_SL_MIN=0.20
EXIT_SL_MAX=0.40

MARKET_TIMEZONE=America/New_York
INTRADAY_INTERVAL_MINUTES=30
PREMARKET_HOUR=9
PREMARKET_MINUTE=25
INTRADAY_END_HOUR=15
INTRADAY_END_MINUTE=30
POSTMARKET_HOUR=15
POSTMARKET_MINUTE=50

STATE_DB_PATH=ai_agent/state/agent_state.db
